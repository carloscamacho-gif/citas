# ================================================================
# FCV TRAINING LAB · Proyecto de citas
# Copia este archivo a .env. NO subas .env a Git.
# ================================================================
COMPOSE_PROJECT_NAME=fcv-citas-training

MYSQL_DATABASE=citas_fcv_app
MYSQL_USER=citas_app
MYSQL_PASSWORD=CitasApp_2026!
MYSQL_ROOT_PASSWORD=RootCitas_2026!
MYSQL_PORT=3307

API_PORT=8080
REACT_PORT=5173
ANGULAR_PORT=4200

# citas_fcv_app es la base que gestiona Flyway/citas-api. citas_fcv_training (si existe en tu volumen)
# queda reservada para explorar database/reference/db.sql sin chocar con las migraciones de la app.
DB_HOST=mysql
DB_PORT=3307
DB_NAME=citas_fcv_app
DB_USER=citas_app
DB_PASSWORD=CitasApp_2026!

# Secretos de JWT de LABORATORIO. Sustituir en cada repo personal.
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# URL pública usada por el frontend cuando corra en el host.
VITE_API_URL=http://localhost:8080
